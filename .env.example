# ============================================================
# I Speak Society Event Registration System - Environment Reference
# This file documents every environment variable used across the
# monorepo. Copy the relevant subset into apps/api/.env,
# apps/web/.env.local, and packages/database/.env - each of these three
# is loaded independently (Next.js, the API, and the Prisma CLI each
# look for their own .env file, not a shared root one).
# ============================================================

# ---- apps/api/.env ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by packages/database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/isociety_ers?schema=public"

# JWT auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Public app URL, used to build registration links embedded in QR codes
APP_BASE_URL=http://localhost:3000

# Cloudinary - hosts uploaded event logos/banners (dashboard > cloud name, API key/secret)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- apps/web/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---- packages/database/.env ----
# (DATABASE_URL again - the Prisma CLI reads its own .env, not apps/api's)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/isociety_ers?schema=public"

# Used once by `pnpm db:seed` to create your first organizer login.
SEED_ORGANIZER_NAME="I Speak Society Admin"
SEED_ORGANIZER_EMAIL="admin@example.com"
SEED_ORGANIZER_PASSWORD="change-this-before-seeding"
