# ============================================================
# I Speak Society Event Registration System - Environment Reference
# This file documents every environment variable used across the
# monorepo. Copy the relevant subset into apps/api/.env and
# apps/web/.env.local - Next.js and the API each load their own.
# ============================================================

# ---- apps/api/.env ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string used by packages/database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/isociety_ers?schema=public"

# JWT auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Public app URL, used to build registration links embedded in QR codes
APP_BASE_URL=http://localhost:3000

# ---- apps/web/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
